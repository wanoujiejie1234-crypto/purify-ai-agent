<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.15</version>
        <relativePath/> <!-- lookup parent from repository -->
    </parent>
    <groupId>com.purify</groupId>
    <artifactId>purify-ai-agent</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>purify-ai-agent</name>
    <description>purify-ai-agent</description>
    <url/>
    <licenses>
        <license/>
    </licenses>
    <developers>
        <developer/>
    </developers>
    <scm>
        <connection/>
        <developerConnection/>
        <tag/>
        <url/>
    </scm>
    <properties>
        <java.version>21</java.version>
        <spring-ai.version>1.0.0</spring-ai.version>
        <!-- jjwt 不在 Spring Boot 的 BOM 里，版本只能自己钉。三件套必须同版本 -->
        <jjwt.version>0.12.6</jjwt.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>${spring-ai.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!--
            MCP 客户端：连外部工具服务器（高德地图），把它们提供的工具交给模型。

            必须是这个名字、也必须不写版本号。M6 时代它叫 spring-ai-mcp-client-spring-boot-starter，
            GA 改名成了 spring-ai-starter-mcp-client；两个版本的 MCP 产物和 1.0.0 的
            ToolCallback / ToolCallbackProvider 对不上，混着用会在运行期炸出来。
            版本由上面的 spring-ai-bom 统一管（1.0.0），这里再写一遍只会写歪。

            不带 -webflux 后缀：那个变体是给 SSE/HTTP 传输用的，本项目用的是 stdio
            （本地起一个 npx 进程），它会把整个 WebFlux 拉进来，和 spring-boot-starter-web 并存没必要。
        -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-mcp-client</artifactId>
        </dependency>

        <dependency>
            <groupId>com.itextpdf</groupId>
            <artifactId>itext-core</artifactId>
            <version>8.0.5</version>
            <type>pom</type>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>com.alibaba.cloud.ai</groupId>
            <artifactId>spring-ai-alibaba-starter-dashscope</artifactId>
            <version>1.0.0.2</version>
        </dependency>
        <dependency>
            <groupId>cn.hutool</groupId>
            <artifactId>hutool-all</artifactId>
            <version>5.8.37</version>
        </dependency>
        <!-- jsoup HTML 解析库 -->
        <dependency>
            <groupId>org.jsoup</groupId>
            <artifactId>jsoup</artifactId>
            <version>1.19.1</version>
        </dependency>
        <dependency>
            <groupId>com.aliyun.oss</groupId>
            <artifactId>aliyun-sdk-oss</artifactId>
            <version>3.18.2</version>
        </dependency>
        <!--
            百炼管控面 SDK：列出一个云知识库下的文件清单（ListIndexDocuments）与切片（ListChunks）。
            知识库同步功能用，见 rag/bailian/BailianConsoleClient。

            为什么不复用上面那个 aliyun-sdk-oss 就够了：两者不是一回事，而且恰好互不干扰。
            OSS 那套是老的非 tea 栈（com.aliyun:aliyun-java-sdk-core / -ram / -kms），
            管控面这套是 tea 栈（com.aliyun:tea / tea-openapi / tea-util / openapiutil）。
            命名空间不相交，所以不会互相顶版本——这点是用 dependency:tree 核过的，不是推测。
            反过来，哪天有人想把两处统一成一个 aliyun 依赖，那才会引入冲突。

            认证也是另一套：这里走阿里云 AK/SK 签名，不是 DashScope 的 api-key。
            配置在 purify.rag.bailian.* 下，刻意不和 aliyun.oss.* 共用——两者要的 RAM
            权限点不同，共用会让「给 OSS 换个 AK」意外把百炼也换掉。
        -->
        <dependency>
            <groupId>com.aliyun</groupId>
            <artifactId>bailian20231229</artifactId>
            <version>2.14.4</version>
        </dependency>
        <!-- 对话记忆持久化：JDBC 仓储 + 数据源 -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-chat-memory-repository-jdbc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!--
            RAG：本地向量库链路（purify.rag.store=pgvector 时才装配）。

            只引 spring-ai-pgvector-store 而不是 spring-ai-starter-vector-store-pgvector：
            starter 会带上 spring-ai-autoconfigure-vector-store-pgvector，那个自动配置
            会拿 spring.ai.vectorstore.pgvector.* 去建一个 VectorStore Bean，
            和本项目「全部手工装配」的做法撞车。这个 jar 不带任何自动配置。

            它自己会传递 spring-jdbc / HikariCP / postgresql 驱动 / pgvector。
            postgresql 仍然显式声明一次：一是把它降到 runtime（我们只连不编译），
            二是让「这个项目需要一个 PG 驱动」在 pom 里看得见。
        -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-pgvector-store</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-markdown-document-reader</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!--
            JSON Schema 生成器。凡是需要「给模型描述一个 Java 类型的结构」的地方都要它，
            最典型的两个用途：每个 @Tool 方法的入参 schema（ToolDefinitions 会为
            FileOperationTool、PDFGenerationTool 等全部工具生成），以及
            ChatClient...entity(Class) 这类结构化输出。

            虽然 spring-ai-model:1.0.0 自己就带了这两个依赖（compile scope、非 optional），
            但仍显式声明一份：一来把版本钉死在 4.37.0，避免某个间接依赖把版本顶掉之后
            运行期才抛 NoClassDefFoundError: ...jsonschema.generator.AnnotationHelper；
            二来让「这个项目依赖 JSON Schema 生成」在 pom 里看得见。
        -->
        <dependency>
            <groupId>com.github.victools</groupId>
            <artifactId>jsonschema-generator</artifactId>
            <version>4.37.0</version>
        </dependency>
        <dependency>
            <groupId>com.github.victools</groupId>
            <artifactId>jsonschema-module-jackson</artifactId>
            <version>4.37.0</version>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
        <!--
            密码哈希：只要 BCrypt，不要整个 Security。

            这个项目引的是 spring-security-crypto 这一个 jar，不是 spring-boot-starter-security。
            两者的差别不是体积，是行为：starter 会拉进一整套过滤器链并默认拦住**所有**请求，
            那样现有十几个接口都要逐个去放行配置，配漏一个的表现是全线 401，
            而排查方向会指向「看起来完全无关」的那个接口。本项目用自己的
            AuthInterceptor + @RequireLogin / @RequireAdmin 做鉴权，只需要这一个工具类。

            版本不写：由 spring-boot-starter-parent 统一管，写了反而会和 Spring Boot 的版本漂移。
        -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-crypto</artifactId>
        </dependency>
        <!--
            发验证码邮件。它只在 spring.mail.host 存在时才装配出 JavaMailSender，
            而这个项目的取向是「配不齐就少一个功能，不影响启动」：
            application.yml 里整个 spring.mail 块是注释掉的（见那里的说明），
            邮件配置放在 application-local.yml；没配时 EmailSender 会退回「只打日志」，
            注册流程照样能走通。
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-mail</artifactId>
        </dependency>
        <!--
            JWT。刻意不手写 HS256：自己实现时最容易错的三处（签名用 String.equals 比、
            信任 header 里的 alg、忘了验 exp）都是能编译、能跑通、只在被人攻击时才暴露的错。
            这是整套栈里唯一有真实 CVE 形状的地方，用现成的库更划算。

            jjwt 不在 Spring Boot 的 BOM 里，所以三个 artifact 都要自己写版本，且必须一致：
            api 是编译期接口，impl 和 jackson 都只在运行期用得上（scope=runtime）。
        -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>${jjwt.version}</version>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <!--
                默认只跑纯单元测试。

                带 @Tag("integration") 的那批会真的调 DashScope 模型、连远程 MySQL/PostgreSQL
                （43.142.91.248），整套跑下来 ~100 秒，占全部测试耗时的 93%。
                其中 CloudKnowledgeMigrationTest 还会往共享的远程库写入数据。

                需要时显式跑：mvnw test -Dgroups=integration
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <excludedGroups>integration</excludedGroups>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <executions>
                    <execution>
                        <id>default-compile</id>
                        <phase>compile</phase>
                        <goals>
                            <goal>compile</goal>
                        </goals>
                        <configuration>
                            <annotationProcessorPaths>
                                <path>
                                    <groupId>org.projectlombok</groupId>
                                    <artifactId>lombok</artifactId>
                                </path>
                            </annotationProcessorPaths>
                        </configuration>
                    </execution>
                    <execution>
                        <id>default-testCompile</id>
                        <phase>test-compile</phase>
                        <goals>
                            <goal>testCompile</goal>
                        </goals>
                        <configuration>
                            <annotationProcessorPaths>
                                <path>
                                    <groupId>org.projectlombok</groupId>
                                    <artifactId>lombok</artifactId>
                                </path>
                            </annotationProcessorPaths>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
